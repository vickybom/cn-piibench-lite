# Copy this file to ".env" (same folder) and paste your real key.
# The .env file is git-ignored and stays on your machine only.
#
# From the QwenCloud "API Keys" page:
#   1. copy your full API key (the "PIIBench Lite" key, starts with sk-ws-...)
#   2. copy the "OpenAI Compatible" Base URL

DASHSCOPE_API_KEY=sk-ws-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PIIAUDITOR_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
